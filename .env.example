# ---------------------------------------------------------------------------
# تنظیمات نرم‌افزار ثبت‌یار — این فایل را به نام .env کپی کنید و مقادیر را ویرایش نمایید
# cp .env.example .env
# ---------------------------------------------------------------------------

# پورت اجرای سرور
PORT=3000

# محیط اجرا: development | production
NODE_ENV=production

# مسیر فایل دیتابیس SQLite (نسبت به ریشه پروژه یا مسیر مطلق)
DATABASE_FILE=./data/store.db

# کلید امضای نشست (Session) — حتماً به یک رشته تصادفی طولانی تغییر دهید
SESSION_SECRET=change-me-to-a-long-random-string

# مدت اعتبار نشست بر حسب ساعت
SESSION_TTL_HOURS=72

# مسیر پوشه پشتیبان‌گیری
BACKUP_DIR=./backups

# ----- تنظیمات موتور صوتی -----
# موتور تشخیص گفتار: web  (استفاده از Web Speech API مرورگر، بدون وابستگی خارجی)
# در آینده می‌توان مقادیر دیگری مثل «google» یا «vosk» اضافه کرد بدون تغییر در بدنه اپ.
VOICE_RECOGNIZER=web
VOICE_LANG=fa-IR

# اطلاعات کاربر مدیر پیش‌فرض که هنگام seed ساخته می‌شود
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=مدیر فروشگاه
