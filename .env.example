# این فایل را به .env کپی کنید (اختیاری). برنامه بدون این فایل هم با مقادیر پیش‌فرض کار می‌کند.
# cp .env.example .env

# محیط اجرا
NODE_ENV=production

# پورت (لیارا خودش PORT را تنظیم می‌کند؛ لازم نیست دست بزنید)
PORT=3000

# مسیر فایل دیتابیس SQLite.
# اگر روی لیارا یک «دیسک» بسازید و اینجا به مسیر آن اشاره کنید، اطلاعات دائمی می‌ماند.
# مثال برای لیارا با دیسکِ mount شده روی /app/data :
# DATABASE_FILE=/app/data/store.db
DATABASE_FILE=./data/store.db
